    {
      "cell_type": "code",
      "source": [
        "def calculate_test_mse(model, test_loader):\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    total_squared_error = 0\n",
        "    total_pixels = 0\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        for images, _ in test_loader:\n",
        "\n",
        "            images = images.to(device)\n",
        "\n",
        "            original_shape = images.shape\n",
        "\n",
        "            images_flat = images.view(\n",
        "                images.size(0),\n",
        "                -1\n",
        "            )\n",
        "\n",
        "            mu, log_var = model.encode(images_flat)\n",
        "\n",
        "            reconstructed = model.decode(mu)\n",
        "\n",
        "            squared_error = (\n",
        "                (images_flat - reconstructed) ** 2\n",
        "            ).sum().item()\n",
        "\n",
        "            total_squared_error += squared_error\n",
        "\n",
        "            total_pixels += images_flat.numel()\n",
        "\n",
        "    return total_squared_error / total_pixels\n",
        "\n",
        "\n",
        "mse_2 = calculate_test_mse(\n",
        "    vae_2,\n",
        "    test_loader\n",
        ")\n",
        "\n",
        "mse_16 = calculate_test_mse(\n",
        "    vae_16,\n",
        "    test_loader\n",
        ")\n",
        "\n",
        "mse_32 = calculate_test_mse(\n",
        "    vae_32,\n",
        "    test_loader\n",
        ")\n",
        "\n",
        "print(\"Test Set MSE\")\n",
        "print(\"-------------------------\")\n",
