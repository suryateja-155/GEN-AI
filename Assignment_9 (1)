      "cell_type": "code",
      "source": [
        "# Part C – Denoising\n",
        "\n",
        "# Get 10 test images\n",
        "sample_images = torch.stack([\n",
        "    test_dataset[i][0]\n",
        "    for i in range(NUM_TEST_IMAGES)\n",
        "]).to(device)\n",
        "\n",
        "# Function to add Gaussian noise\n",
        "def add_noise(images, noise_std=NOISE_STD):\n",
        "\n",
        "    noise = torch.randn_like(images) * noise_std\n",
        "\n",
        "    noisy_images = images + noise\n",
        "\n",
        "    return torch.clamp(noisy_images, 0, 1)\n",
        "\n",
        "\n",
        "# Add noise\n",
        "noisy_images = add_noise(sample_images)\n",
        "\n",
        "# Flatten noisy images\n",
        "noisy_flat = noisy_images.view(\n",
        "    noisy_images.size(0),\n",
        "    -1\n",
        ")\n",
        "\n",
        "vae_2.eval()\n",
        "\n",
        "# Pass noisy images through VAE\n",
        "with torch.no_grad():\n",
        "\n",
        "    mu, log_var = vae_2.encode(noisy_flat)\n",
        "\n",
        "    denoised_flat = vae_2.decode(mu)\n",
        "\n",
        "\n",
        "# Convert 784 values back to 28 x 28\n",
        "denoised_images = denoised_flat.view(\n",
        "    -1, 1, 28, 28\n",
        ")\n",
        "\n",
        "\n",
        "# Calculate MSE\n",
        "\n",
        "noisy_mse = torch.mean(\n",
        "    (sample_images - noisy_images) ** 2\n",
        ").item()\n",
        "\n",
        "denoised_mse = torch.mean(\n",
        "    (sample_images - denoised_images) ** 2\n",
        ").item()\n",
        "\n",
        "\n",
        "print(\"Noisy Image MSE:\", noisy_mse)\n",
