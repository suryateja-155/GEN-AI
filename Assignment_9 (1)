      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Get 10 test images\n",
        "\n",
        "sample_images = torch.stack([\n",
        "    test_dataset[i][0]\n",
        "    for i in range(NUM_TEST_IMAGES)\n",
        "]).to(device)\n",
        "\n",
        "# Flatten images for VAE\n",
        "sample_flat = sample_images.view(\n",
        "    sample_images.size(0),\n",
        "    -1\n",
        ")\n",
        "\n",
        "vae_2.eval()\n",
        "\n",
        "with torch.no_grad():\n",
        "\n",
        "    mu, log_var = vae_2.encode(sample_flat)\n",
        "\n",
        "    # Use mean for deterministic reconstruction\n",
        "    reconstructed_flat = vae_2.decode(mu)\n",
        "\n",
        "# Convert back to image shape\n",
        "reconstructed_images = reconstructed_flat.view(\n",
        "    -1, 1, 28, 28\n",
        ")\n",
        "\n",
        "print(\"Original shape:\", sample_images.shape)\n",
        "print(\"Reconstructed shape:\", reconstructed_images.shape)"
