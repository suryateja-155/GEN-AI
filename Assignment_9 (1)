        "## **Step 3: Define the Variational Autoencoder**\n",
        "\n",
        "The VAE architecture used in this assignment is:\n",
        "\n",
        "784 → 256 → 64 → Latent Space → 64 → 256 → 784\n",
        "\n",
        "The encoder converts the 784-pixel input into a smaller latent representation.\n",
        "\n",
        "The decoder reconstructs the original 784-pixel image from the latent representation.\n",
        "\n",
        "The latent dimensions used are 2, 16 and 32."
      ],
      "metadata": {
        "id": "33CzRmNHHf4N"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "class VAE(nn.Module):\n",
        "\n",
        "    def __init__(self, latent_dim):\n",
        "        super(VAE, self).__init__()\n",
        "\n",
        "        # Encoder\n",
        "        self.encoder = nn.Sequential(\n",
        "            nn.Linear(784, 256),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(256, 64),\n",
        "            nn.ReLU()\n",
        "        )\n",
        "\n",
        "        # Latent space\n",
        "        self.fc_mu = nn.Linear(64, latent_dim)\n",
        "        self.fc_log_var = nn.Linear(64, latent_dim)\n",
        "\n",
        "        # Decoder\n",
        "        self.decoder = nn.Sequential(\n",
        "            nn.Linear(latent_dim, 64),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(64, 256),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(256, 784),\n",
        "            nn.Sigmoid()\n",
        "        )\n",
        "\n",
        "    def encode(self, x):\n",
        "        h = self.encoder(x)\n",
        "\n",
        "        mu = self.fc_mu(h)\n",
        "        log_var = self.fc_log_var(h)\n",
        "\n",
        "        return mu, log_var\n",
        "\n",
        "    def reparameterize(self, mu, log_var):\n",
        "\n",
        "        std = torch.exp(0.5 * log_var)\n",
        "\n",
        "        epsilon = torch.randn_like(std)\n",
        "\n",
        "        return mu + epsilon * std\n",
        "\n",
        "    def decode(self, z):\n",
        "        return self.decoder(z)\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        mu, log_var = self.encode(x)\n",
        "\n",
        "        z = self.reparameterize(mu, log_var)\n",
        "\n",
        "        reconstruction = self.decode(z)\n",
        "\n",
        "        return reconstruction, mu, log_var"
      ],
      "metadata": {
        "id": "ugpgIFVaHchz"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## **Step 4: Define the VAE Loss Function**\n",
        "\n",
        "The VAE loss consists of two parts:\n",
        "\n",
        "1. Reconstruction Loss\n",
        "2. KL Divergence\n",
        "\n",
        "The reconstruction loss measures how close the reconstructed image is to the original image.\n",
        "\n",
        "The KL divergence regularizes the latent space so that it follows a normal distribution."
      ],
      "metadata": {
        "id": "7d_hP9-uHnqy"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def vae_loss(reconstruction, x, mu, log_var):\n",
        "\n",
        "    reconstruction_loss = nn.functional.mse_loss(\n",
        "        reconstruction,\n",
        "        x,\n",
        "        reduction=\"sum\"\n",
        "    )\n",
        "\n",
        "    kl_loss = -0.5 * torch.sum(\n",
        "        1 + log_var - mu.pow(2) - log_var.exp()\n",
        "    )\n",
        "\n",
        "    total_loss = reconstruction_loss + kl_loss\n",
        "\n",
        "    return total_loss, reconstruction_loss, kl_loss"
      ],
      "metadata": {
        "id": "POClA16XHkhd"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## **Step 5: Train the VAE**\n",
        "\n",
        "The VAE is trained using the MNIST training dataset.\n",
        "\n",
        "The optimizer used is Adam with a learning rate of 0.001."
      ],
      "metadata": {
        "id": "6VgA7aFaHvj8"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def train_vae(model, train_loader, epochs=EPOCHS):\n",
        "\n",
        "    optimizer = optim.Adam(\n",
        "        model.parameters(),\n",
        "        lr=LEARNING_RATE\n",
        "    )\n",
        "\n",
        "    total_losses = []\n",
        "    reconstruction_losses = []\n",
        "    kl_losses = []\n",
        "\n",
        "    model.train()\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "\n",
        "        epoch_total = 0\n",
        "        epoch_reconstruction = 0\n",
        "        epoch_kl = 0\n",
        "\n",
        "        for images, _ in train_loader:\n",
        "\n",
        "            images = images.to(device)\n",
        "\n",
        "            # Flatten 28x28 image into 784 values\n",
        "            images = images.view(images.size(0), -1)\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "\n",
        "            reconstruction, mu, log_var = model(images)\n",
        "\n",
        "            loss, recon_loss, kl_loss = vae_loss(\n",
        "                reconstruction,\n",
        "                images,\n",
        "                mu,\n",
        "                log_var\n",
        "            )\n",
        "\n",
        "            loss.backward()\n",
        "\n",
        "            optimizer.step()\n",
        "\n",
        "            epoch_total += loss.item()\n",
        "            epoch_reconstruction += recon_loss.item()\n",
        "            epoch_kl += kl_loss.item()\n",
        "\n",
        "        total_losses.append(epoch_total)\n",
        "        reconstruction_losses.append(epoch_reconstruction)\n",
        "        kl_losses.append(epoch_kl)\n",
        "\n",
        "        print(\n",
        "            f\"Epoch [{epoch+1}/{epochs}] \"\n",
        "            f\"Total Loss: {epoch_total:.2f} \"\n",
        "            f\"Reconstruction Loss: {epoch_reconstruction:.2f} \"\n",
        "            f\"KL Loss: {epoch_kl:.2f}\"\n",
        "        )\n",
        "\n",
        "    return total_losses, reconstruction_losses, kl_losses"
      ],
      "metadata": {
        "id": "fXatm_WxHs8B"
      },
      "execution_count": null,
      "outputs": []
